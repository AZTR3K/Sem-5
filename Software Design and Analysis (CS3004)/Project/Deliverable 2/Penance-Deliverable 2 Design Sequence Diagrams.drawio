<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:144.0) Gecko/20100101 Firefox/144.0" version="28.2.8">
  <diagram name="Page-1" id="OLHkkYJ8_WMjXkE53sl2">
    <mxGraphModel dx="1426" dy="1879" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-01: Move Player\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\n\n&#39; Step 1\nPlayer -&gt; Game : 1. Press movement key/joystick\nGame -&gt; Game : 1.1 Translate input → move character\nGame -&gt; Game : 1.2 Update position and play walking/running animation\n\n&#39; Step 2\nPlayer -&gt; Game : 2. Encounters obstacle\nGame -&gt; Game : 2.1 Stop or trigger jump/climb\n\n&#39; Step 3\nPlayer -&gt; Game : 3. Performs extended movement (Climb/Double Jump)\nGame -&gt; Game : 3.1 Execute animation and physics update\nGame --&gt; Player : 3.2 Character moves visually on screen\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="60" y="-1080" width="736" height="490" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-02: Attack Enemy\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Press attack button\nGame -&gt; Game: 1.1 Play attack animation and check collision\n\n&#39; Step 2\nalt Attack connects\n    Game -&gt; Game: 2.1 Apply damage to enemy, reduce health\nelse Attack misses\n    Game -&gt; Game: 2.2 No damage registered\nend\n\n&#39; Step 3\nGame -&gt; Player: 3. Show hit or miss feedback (animation, sound)\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-3">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="-500" width="730" height="479.71" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-03: Collect Item\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Move near item\nGame -&gt; Game: 1.1 Highlight item\n\n&#39; Step 2\nPlayer -&gt; Game: 2. Press \&quot;Interact\&quot; button\nGame -&gt; Game: 2.1 Remove item from world and add to inventory\n\n&#39; Step 3\nGame -&gt; Player: 3. Show item collected (UI update)\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-4">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="60" y="30" width="730" height="469.02" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-04: Dodge Attacks\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\nparticipant \&quot;Enemy AI\&quot; as EnemyAI\n\n== Dodge Initiation ==\nPlayer -&gt; Game: 1. Press dodge button\nGame -&gt; Game: 1.1 Play dodge animation\nGame -&gt; Game: 1.2 Grant temporary invulnerability frames (i-frames)\n\n== Attack Phase ==\nEnemyAI -&gt; Game: 2. Perform attack targeting player\nGame -&gt; Game: 2.1 Check dodge timing\nalt Dodge successful\n    Game -&gt; EnemyAI: 2.2 Register attack miss\n    Game -&gt; Player: 2.3 Maintain invulnerability\nelse Dodge failed\n    Game -&gt; Player: 2.4 Apply damage\nend\n\n== Postcondition ==\nGame -&gt; Game: 3. End invulnerability frames\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-5">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="590" width="727" height="746.53" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-05: Interact with NPCs\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\nparticipant \&quot;NPC (AI Controlled)\&quot; as NPC\n\n== Approach ==\nPlayer -&gt; Game: 1. Move near NPC\nGame -&gt; NPC: 1.1 Detect proximity\nNPC -&gt; Game: 1.1.1 Becomes interactive\n\n== Interaction ==\nPlayer -&gt; Game: 2. Press interact key/button\nGame -&gt; NPC: 2.1 Trigger interaction\nNPC -&gt; Game: 2.1.1 Send dialogue data\nGame -&gt; Player: 2.2 Display dialogue menu/options\n\n== Postcondition ==\nnote right of Game\nDialogue executed.  \nPossible outcomes:  \n- Start quest  \n- Initiate trade  \n- End conversation\nend note\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-6">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="1400" width="727" height="844.35" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-06: Manage Companion Relationships\n\nactor Player\nparticipant \&quot;Game System\&quot; as Game\nparticipant \&quot;Kaelan (Companion)\&quot; as Kaelan\nparticipant \&quot;Rhys (Companion)\&quot; as Rhys\n\n== Moral Choice / Interaction ==\nPlayer -&gt; Game: 1. Make moral choice or interact (via UC-17 / UC-05)\nGame -&gt; Kaelan: 1.1 Evaluate approval/disapproval\nGame -&gt; Rhys: 1.2 Evaluate approval/disapproval\nGame -&gt; Game: 1.3 Update relationship status values\nGame -&gt; Game: 1.4 Queue next mission (based on progression meter)\n\n== Dialogue Selection ==\nPlayer -&gt; Game: 2. Select dialogue option\nGame -&gt; Game: 2.1 Activate corresponding mission path\n\n== Story Progression ==\nPlayer -&gt; Game: 3. Progress story events\nGame -&gt; Kaelan: 3.1 Adapt future dialogue/behavior\nGame -&gt; Rhys: 3.2 Adapt future dialogue/behavior\nGame -&gt; Player: 3.3 Reflect consequences in story and interactions\n\n== Postcondition ==\nnote right of Game\n- Relationship values updated  \n- Dialogue and missions adapt dynamically  \n- Future story events depend on choices\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-7">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="2340" width="727" height="602.02" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-07: Choose Narrative Path\n\nactor Player\nparticipant Game\nparticipant Companions\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Player makes a moral choice\nGame -&gt; Game: 1.1 System evaluates choice or interaction\nGame -&gt; Companions: 1.2 System updates companion relationship status\n\n&#39; Step 2\nPlayer -&gt; Game: 2. Player continues gameplay or initiates dialogue\nGame -&gt; Game: 2.1 System activates story events/dialogue/encounters\nGame -&gt; Companions: 2.2 Companions react based on chosen path\n\n&#39; Step 3\nPlayer -&gt; Game: 3. Player encounters a narrative milestone\nGame -&gt; Game: 3.1 System adapts milestone content to prior choices\nGame -&gt; Player: 3.2 Advance story toward one of two endings\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-8">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="60" y="3010" width="730" height="470.22" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-08: Make Moral Choice\n\nactor Player\nparticipant Game\nparticipant Companions\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Player defeats an enemy (via UC-02: Attack Enemy)\nGame -&gt; Game: 1.1 System pauses combat and shows spare/execute prompt\n\n&#39; Step 2\nPlayer -&gt; Game: 2. Player selects spare or execute option\nGame -&gt; Game: 2.1 System records choice and updates narrative variables\n\n&#39; Step 3\nPlayer -&gt; Game: 3. Player confirms choice\nGame -&gt; Companions: 3.1 System triggers companion reactions\nGame -&gt; Player: 3.2 Narrative impact (clue or insight)\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-9">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="60" y="3540" width="730" height="386.73" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-09: Attack Player\n\nskinparam ParticipantPadding 70\n\nparticipant \&quot;Enemy AI\&quot; as EnemyAI\nactor Player\nparticipant Game\n\n&#39; Step 1\nEnemyAI -&gt; Game: 1. Enemy AI decides to attack\nGame -&gt; EnemyAI: 1.1 Attack animation is triggered\n\n&#39; Step 2\nEnemyAI -&gt; Game: 2. Player in range\nGame -&gt; Player: 2.1 Player health reduced (if not dodged/blocked)\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-10">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="60" y="4000" width="730" height="386.26" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-10: Chase Player\n\nactor Player\nparticipant \&quot;Enemy AI\&quot; as AI\n\n== Detection Phase ==\nPlayer -&gt; AI : 1. Player enters detection range\nAI -&gt; AI : 1.1 Switches to chase mode\n\n== Chase Phase ==\nPlayer -&gt; AI : 2. Player moves away\nAI -&gt; Player : 2.1 Moves closer to player\n\nloop While player in aggro range\n    Player -&gt; AI : 3.1 Update position\n    AI -&gt; Player : 3.2 Continue chase\nend\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-11">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="4460" width="727" height="794.08" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-11: Perform Special Move\n\nactor \&quot;Enemy AI\&quot; as Enemy\nparticipant \&quot;Game System\&quot; as System\nactor \&quot;Player\&quot; as Player\n\n== Initiation ==\nEnemy -&gt; System : 1. Trigger special move\nSystem -&gt; System : 1.1 Play special move animation\n\n== Targeting ==\nSystem -&gt; Player : 2. Target player\nPlayer -&gt; System : 2.1 Update health/status\n\n== Conditions ==\nnote over Enemy,Player\n  Pre-condition: Enemy AI has enough mana/energy.\n  Post-condition: Player receives damage/effects if hit.\n  Dependency: Attack Player\nend note\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-12">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="5340" width="727" height="829.28" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-12: Navigate Menu\n\nactor \&quot;Player\&quot; as Player\nparticipant \&quot;Game System\&quot; as Game\n\n== Menu Access ==\nPlayer -&gt; Game : 1. Open main menu / pause menu\nGame -&gt; Game : 1.1 Display menu options\\n(e.g., Start, Settings, Quit)\n\n== Navigation ==\nPlayer -&gt; Game : 2. Scroll or select an option\nGame -&gt; Game : 2.1 Highlight selected option\n\n== Selection ==\nPlayer -&gt; Game : 3. Confirm selection\nGame -&gt; Game : 3.1 Execute chosen option\\n(e.g., open settings, start game, resume)\n\n== Conditions ==\nnote over Player,Game\n  Pre-condition: Game is running, menu accessible.\n  Post-condition: Desired menu option selected.\n  Dependency: None.\nend note\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-13">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="6250" width="727" height="869.07" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-13: Load Textures\n\nactor Player\nparticipant Game\nparticipant \&quot;Game Engine\&quot; as Engine\nparticipant \&quot;Texture Manager\&quot; as TextureMgr\nparticipant \&quot;Renderer\&quot; as Renderer\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Start new game or load level\nGame -&gt; Engine: 1.1 Begin loading texture files\nEngine -&gt; TextureMgr: 1.2 Load texture assets into memory\nTextureMgr --&gt; Engine: 1.3 Return loaded textures\n\n&#39; Step 2\nEngine -&gt; Game: 2. Notify loading progress\nGame -&gt; Player: 2.1 Update progress bar/indicator\n\n&#39; Step 3\nPlayer -&gt; Game: 3. Wait until loading completes\nGame -&gt; Renderer: 3.1 Apply textures to models, environment, and UI\nRenderer --&gt; Player: 3.2 Display textured scene\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-14">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="7170" width="727" height="380.65" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-14: Choose Difficulty\n\nactor Player\nparticipant Game\nparticipant \&quot;Menu System\&quot; as Menu\nparticipant \&quot;Game Settings\&quot; as Settings\nparticipant \&quot;AI Manager\&quot; as AI\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Open Settings or New Game menu\nGame -&gt; Menu: 1.1 Display difficulty options (Easy, Normal, Hard)\n\n&#39; Step 2\nPlayer -&gt; Menu: 2. Highlight difficulty option\nMenu -&gt; Game: 2.1 Notify selected option\nGame -&gt; Menu: 2.2 Display description of difficulty\n\n&#39; Step 3\nPlayer -&gt; Menu: 3. Confirm selection\nMenu -&gt; Game: 3.1 Send chosen difficulty\n\n&#39; Step 4\nGame -&gt; Settings: 4. Update difficulty parameters\nSettings -&gt; AI: 4.1 Adjust AI behavior and damage rules\nSettings -&gt; Game: 4.2 Update progression parameters\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-15">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="63" y="7640" width="727" height="340.09" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-15: Manage State\n\nactor Player\nparticipant Game\nparticipant \&quot;Save/Load Interface\&quot; as Interface\nparticipant \&quot;File System\&quot; as FileSys\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Select \&quot;Save\&quot; or \&quot;Load\&quot;\nGame -&gt; Interface: 1.1 Open save/load interface\n\n&#39; Step 2\nPlayer -&gt; Interface: 2. Choose save slot or file\nInterface -&gt; Game: 2.1 Send selected slot info\nGame -&gt; FileSys: 2.2 Retrieve slot details\nFileSys --&gt; Game: 2.3 Return progress, time, location\nGame -&gt; Interface: 2.4 Display slot details\n\n&#39; Step 3\nPlayer -&gt; Interface: 3. Confirm choice\nInterface -&gt; Game: 3.1 Send confirmation\nGame -&gt; FileSys: 3.2 Save or Load player data\nFileSys --&gt; Game: 3.3 Confirm operation\nGame -&gt; Player: 3.4 Notify save/load completion\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-16">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="60" y="8060" width="730" height="626.37" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle UC-16: Set Story Direction\n\nactor Player\nparticipant Game\nparticipant \&quot;Companion Manager\&quot; as Companions\nparticipant \&quot;Story Engine\&quot; as Story\n\n&#39; Step 1\nPlayer -&gt; Game: 1. Make moral choice / interact with companion\nGame -&gt; Companions: 1.1 Evaluate choice and update relationship status\nCompanions --&gt; Game: 1.1.1 Return updated relationship data\n\n&#39; Step 2\nGame -&gt; Story: 2. Update narrative direction based on choice\nStory --&gt; Game: 2.1 Provide next act or scene alignment\n\n&#39; Step 3\nPlayer -&gt; Game: 3. Continue gameplay\nGame -&gt; Story: 3.1 Adapt cutscenes, dialogue, and encounters\nStory -&gt; Game: 3.1.1 Trigger act-specific content (The Journey, The Revelation)\nGame -&gt; Player: 3.2 Present narrative progression\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="M7-BL0g--Yt1bzaq5HT9-17">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="60" y="8750" width="730" height="386.13" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
