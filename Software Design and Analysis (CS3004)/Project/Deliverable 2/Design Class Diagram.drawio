<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64; rv:144.0) Gecko/20100101 Firefox/144.0" version="28.2.8">
  <diagram name="Page-1" id="oT52OhVw59aGg8St_js2">
    <mxGraphModel dx="2276" dy="1879" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\ntitle Design Class Diagram\n\nleft to right direction\nskinparam linetype ortho\nskinparam classAttributeIconSize 0\nskinparam nodesep 40\nskinparam ranksep 35\n\n&#39; =======================\n&#39; ABSTRACT / BASE CLASSES\n&#39; =======================\nabstract class Character {\n    - name : string\n    - health : int\n    - position : Vector2D\n    + move()\n    + takeDamage(amount : int)\n}\n\nabstract class AIControlled extends Character {\n    - behaviorState : string\n    + detectTarget()\n    + performAction()\n}\n\n&#39; =======================\n&#39; CONCRETE CLASSES\n&#39; =======================\nclass Player extends Character {\n    - inventory : Inventory\n    + attack()\n    + dodge()\n    + collectItem()\n    + interactWithNPC()\n    + makeMoralChoice()\n    + chooseNarrativePath()\n    + navigateMenu()\n}\n\nclass EnemyAI extends AIControlled {\n    + chasePlayer()\n    + attackPlayer()\n    + performSpecialMove()\n}\n\nclass NPC extends AIControlled {\n    - dialogueTree : Dialogue\n    + interact()\n    + triggerDialogue()\n}\n\nclass Companion extends NPC {\n    - relationshipValue : int\n    + reactToChoice()\n    + updateRelationship()\n}\n\nclass Game {\n    - state : string\n    - difficulty : string\n    - currentLevel : int\n    - companions : List&lt;Companion&gt;\n    - aiManager : AIManager\n    - storyEngine : StoryEngine\n    - textureManager : TextureManager\n    - fileSystem : FileSystem\n    + processInput()\n    + update()\n    + render()\n    + saveGame()\n    + loadGame()\n    + manageState()\n    + updateRelationships()\n    + triggerEvent()\n}\n\nclass GameEngine {\n    - version : string\n    + loadTextures()\n    + manageRendering()\n    + handlePhysics()\n}\n\nclass TextureManager {\n    - textureList : List&lt;Texture&gt;\n    + loadTexture()\n    + getTexture()\n    + unloadTexture()\n}\n\nclass Renderer {\n    - frameRate : int\n    + renderScene()\n    + applyTextures()\n}\n\nclass AIManager {\n    - difficultyLevel : string\n    + adjustBehavior()\n    + spawnEnemies()\n}\n\nclass MenuSystem {\n    - currentMenu : string\n    + displayOptions()\n    + highlightOption()\n    + executeSelection()\n}\n\nclass GameSettings {\n    - difficulty : string\n    + updateDifficulty()\n    + applySettings()\n}\n\nclass StoryEngine {\n    - currentAct : string\n    - moralVariables : Map&lt;string, int&gt;\n    + updateStoryDirection()\n    + triggerScene()\n    + evaluateChoice()\n}\n\nclass FileSystem {\n    - saveSlots : List&lt;File&gt;\n    + saveData()\n    + loadData()\n}\n\nclass SaveLoadInterface {\n    + openInterface()\n    + confirmChoice()\n}\n\nclass Inventory {\n    - items : List&lt;Item&gt;\n    + addItem()\n    + removeItem()\n}\n\nclass Item {\n    - name : string\n    - type : string\n    + useItem()\n}\n\nclass Dialogue {\n    - lines : List&lt;string&gt;\n    + nextLine()\n}\n\nclass Vector2D {\n    - x : float\n    - y : float\n}\n\n&#39; =======================\n&#39; RELATIONSHIPS WITH CARDINALITY\n&#39; =======================\n\n&#39; Composition / Aggregation\nPlayer \&quot;1\&quot; *-- \&quot;1\&quot; Inventory\nInventory \&quot;1\&quot; *-- \&quot;0..*\&quot; Item\nNPC \&quot;1\&quot; *-- \&quot;1\&quot; Dialogue\nGame \&quot;1\&quot; *-- \&quot;1\&quot; GameEngine\nGame \&quot;1\&quot; *-- \&quot;1\&quot; TextureManager\nGame \&quot;1\&quot; *-- \&quot;1\&quot; Renderer\nGame \&quot;1\&quot; *-- \&quot;1\&quot; AIManager\nGame \&quot;1\&quot; *-- \&quot;1\&quot; GameSettings\nGame \&quot;1\&quot; *-- \&quot;1\&quot; StoryEngine\nGame \&quot;1\&quot; *-- \&quot;1\&quot; FileSystem\nGame \&quot;1\&quot; *-- \&quot;1\&quot; SaveLoadInterface\nGame \&quot;1\&quot; *-- \&quot;1\&quot; MenuSystem\nGame \&quot;1\&quot; *-- \&quot;0..*\&quot; Companion\n\nGameEngine \&quot;1\&quot; *-- \&quot;1\&quot; TextureManager\nGameEngine \&quot;1\&quot; *-- \&quot;1\&quot; Renderer\nAIManager \&quot;1\&quot; *-- \&quot;0..*\&quot; EnemyAI\nStoryEngine \&quot;1\&quot; *-- \&quot;0..*\&quot; Companion\n\n&#39; Associations\nPlayer \&quot;1\&quot; --&gt; \&quot;1\&quot; Game\nPlayer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; EnemyAI\nPlayer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; NPC\nPlayer \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Companion\nGame \&quot;1\&quot; --&gt; \&quot;1\&quot; Player\nGame \&quot;1\&quot; --&gt; \&quot;1\&quot; StoryEngine\nGame \&quot;1\&quot; --&gt; \&quot;1\&quot; AIManager\n\n&#39; Inheritance\nCharacter &lt;|-- Player\nCharacter &lt;|-- AIControlled\nAIControlled &lt;|-- EnemyAI\nAIControlled &lt;|-- NPC\nNPC &lt;|-- Companion\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="X_iybXrRNP8TUuJ-PgiW-1">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-170" y="-490" width="1201" height="1793" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
